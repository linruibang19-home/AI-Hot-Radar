# Secrets: only .env.example is committed (AHR-QSO-700 §3).
.env
.env.local
*.pem

# Node
node_modules/
.next/
out/
npm-debug.log*
*.tsbuildinfo

# Java
target/
*.class

# Flyway migrations are copied here at build time from database/migrations,
# which is the single canonical source (AHR-SPEC-000 §8).
apps/core-api/src/main/resources/db/migration/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime artifacts
source-health.json
source-health.md

# Playwright e2e artefacts (the suite installs into its own directory so it
# never enters the web app's runtime image).
apps/web/e2e/node_modules/
apps/web/e2e/test-results/
apps/web/e2e/playwright-report/

# Agent worktrees created by the coding tool.
.claude/worktrees/

# Git Bash rewrites `-v "$PWD/x:/y"` into a Windows path and leaves a literal
# `x;D` directory behind. Ignored so one stray run cannot be committed; the fix
# is to use PowerShell for docker mounts (see DEVELOPMENT.md §6).
*;D/
