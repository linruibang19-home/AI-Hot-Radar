# Runtime
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
WORKER_BASE_URL=http://worker:8000
INTERNAL_SERVICE_TOKEN=change-me

# PostgreSQL / pgvector
POSTGRES_DB=ai_hot_radar
POSTGRES_USER=ai_hot_radar
POSTGRES_PASSWORD=change-me
# DATABASE_URL is no longer set here. Compose cannot interpolate ${VAR} from
# this file, so a DSN written here went stale the moment the password changed
# while POSTGRES_* stayed correct. ai-service composes the conninfo from the
# POSTGRES_* values below (ahr/config.py); set DATABASE_URL only to override.

# Redis
REDIS_URL=redis://redis:6379/0

# Public-source access
CRAWLER_USER_AGENT=AIHotRadarBot/1.0 (+https://example.com/bot)
GITHUB_TOKEN=
OPENALEX_MAILTO=

# Models: use a gateway/provider adapter; never commit real keys
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# SiliconFlow, OpenAI-compatible. Dimensions are pinned by migration V012;
# changing the model means re-embedding every chunk, not just editing this.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Object storage is optional in MVP; raw bytes may begin in PostgreSQL
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Production only (infra/compose/docker-compose.prod.yml) -----------------
# Place a copy of this file at infra/compose/.env on the server. The production
# compose file reads it directly rather than reaching for the repository root,
# because on a server the repository root is a deploy checkout, not a workspace.
#
# Use NEW secrets here. The local keys have appeared in development transcripts
# and must be rotated before anything is published (m5-deployment.md §6).

# Which images to run. IMAGE_TAG is the commit sha that release.yml pushed;
# pinning it is what makes a rollback a one-line change.
IMAGE_REPO=ghcr.io/linruibang19-home/ai-hot-radar
IMAGE_TAG=latest

# The public origin. PUBLIC_BASE_URL feeds canonical URLs, og: tags and
# sitemap.xml, so leaving it at localhost ships a sitemap pointing at the
# visitor's own machine.
SITE_DOMAIN=kuritian.online
# ACME_EMAIL is where Let's Encrypt sends expiry warnings; blank is allowed but
# means no warning if renewal ever breaks.
ACME_EMAIL=

# Nightly pg_dump retention, in days.
BACKUP_KEEP_DAYS=7

