# Runtime
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
WORKER_BASE_URL=http://worker:8000
INTERNAL_SERVICE_TOKEN=change-me

# PostgreSQL / pgvector
POSTGRES_DB=ai_hot_radar
POSTGRES_USER=ai_hot_radar
POSTGRES_PASSWORD=change-me
# DATABASE_URL is no longer set here. Compose cannot interpolate ${VAR} from
# this file, so a DSN written here went stale the moment the password changed
# while POSTGRES_* stayed correct. ai-service composes the conninfo from the
# POSTGRES_* values below (ahr/config.py); set DATABASE_URL only to override.

# Redis
REDIS_URL=redis://redis:6379/0

# Public-source access
CRAWLER_USER_AGENT=AIHotRadarBot/1.0 (+https://example.com/bot)
GITHUB_TOKEN=
OPENALEX_MAILTO=

# Models: use a gateway/provider adapter; never commit real keys
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# SiliconFlow, OpenAI-compatible. Dimensions are pinned by migration V012;
# changing the model means re-embedding every chunk, not just editing this.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_ATTEMPTS=3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=20
RERANKER_MAX_ATTEMPTS=2

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=AI Hot Radar
SMTP_AUTH=true
SMTP_STARTTLS=true
# HMAC key for confirmation and unsubscribe links. Generate with:
# openssl rand -hex 32
AHR_SUBSCRIPTION_TOKEN_SECRET=
EMAIL_DISPATCH_INTERVAL_MS=300000

# Cost and abuse ceilings.
#
# The per-caller quota (AHR-API-500 §4) defaults to the spec's 3/min and 20/day
# and needs no entry here. Set these only to loosen it locally: everything
# behind the Docker gateway shares one bucket, so a developer and their own
# smoke tests spend the same twenty.
RAG_RATE_PER_MINUTE=
RAG_RATE_PER_DAY=

# Observability thresholds. A status remains "insufficient_data" until the
# minimum sample count is reached; it must not report a tiny sample as healthy.
RAG_SLO_MIN_SAMPLES=20
RAG_SLO_TOTAL_P95_MS=30000
RAG_SLO_EMBED_P95_MS=5000
RAG_SLO_RERANK_P95_MS=10000
RAG_SLO_GENERATE_P95_MS=15000
RAG_SLO_NUMERIC_AUDIT_P95_MS=15000
RAG_SLO_SUPPORT_P95_MS=10000

# A ceiling on what the whole deployment spends per day, counted from
# provider-reported tokens in `llm_usage`. 0 disables it. Bounds the deployment
# where the quota above bounds one visitor, and unlike that quota it does not
# vanish when Redis restarts.
#
# It does NOT replace the provider-side cap: the embedding and rerank accounts
# are not recorded in `llm_usage`, and tokens are not money. Set it from
# `ahr.cli usage --days 7`, not from this default.
LLM_DAILY_TOKEN_LIMIT=2000000

# Object storage is optional in MVP; raw bytes may begin in PostgreSQL
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Production only (infra/compose/docker-compose.prod.yml) -----------------
# Place a copy of this file at infra/compose/.env on the server. The production
# compose file reads it directly rather than reaching for the repository root,
# because on a server the repository root is a deploy checkout, not a workspace.
#
# Use NEW secrets here. The local keys have appeared in development transcripts
# and must be rotated before anything is published (m5-deployment.md §6).

# Which images to run. IMAGE_TAG is the commit sha that release.yml pushed;
# pinning it is what makes a rollback a one-line change.
IMAGE_REPO=ghcr.io/linruibang19-home/ai-hot-radar
IMAGE_TAG=latest

# The public origin. PUBLIC_BASE_URL feeds canonical URLs, og: tags and
# sitemap.xml, so leaving it at localhost ships a sitemap pointing at the
# visitor's own machine.
SITE_DOMAIN=kuritian.online
# Override the local value above when this file is copied to infra/compose/.env.
PUBLIC_BASE_URL=https://kuritian.online
# ACME_EMAIL is where Let's Encrypt sends expiry warnings; blank is allowed but
# means no warning if renewal ever breaks.
ACME_EMAIL=

# The first admin credential, hashed at rest by core-api on startup. Every
# /api/v1/admin/** request needs it as `Authorization: Bearer <token>`.
# At least 32 characters — core-api refuses to start with a shorter one,
# because the stored hash is plain SHA-256 and that is only adequate for a
# high-entropy secret. Generate with: openssl rand -hex 32
AHR_ADMIN_BOOTSTRAP_TOKEN=

# A second, read-only credential used by the web container to render the
# source console during SSR. Separate from the one above on purpose: the
# web tier never mutates, so it should not hold a token that can.
AHR_ADMIN_VIEWER_TOKEN=

# Nightly pg_dump retention, in days.
BACKUP_KEEP_DAYS=7

# Required human attestations checked by infra/scripts/preflight.sh. They are
# deliberately false in the template: change them only after completing the
# provider-console and off-host-backup steps.
PROVIDER_BUDGET_CAP_CONFIRMED=false
BACKUP_OFFSITE_CONFIRMED=false

# Production health alerts. SMTP reuses the report delivery account. A dedicated
# Slack-compatible HTTPS webhook remains optional; configured channels are both
# attempted, and neither destination nor credential is logged.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_FAILURE_THRESHOLD=3
MONITOR_INTERVAL_SECONDS=60
BACKUP_MAX_AGE_SECONDS=93600

# Pin the public quota explicitly in production. Blank values earlier in this
# template are for the deliberately looser local stack.
RAG_RATE_PER_MINUTE=3
RAG_RATE_PER_DAY=20

# Leave empty until a real production collector exists. Pointing at the local
# compose-only otel-collector name would create a permanent exporter failure.
OTEL_EXPORTER_OTLP_ENDPOINT=

