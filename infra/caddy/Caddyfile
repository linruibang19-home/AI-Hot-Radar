# Edge for the production stack (AHR-QSO-700 §4).
#
# Caddy rather than nginx: certificate issuance and renewal are the default
# here, and this site has no routing that needs more. The whole reverse proxy is
# one line because there is exactly one upstream — `web` proxies to core-api and
# ai-service itself, on the Compose network, so neither is reachable from
# outside even by path.
#
# Cloudflare sits in front. Set SSL/TLS to **Full (strict)**: with Flexible the
# Cloudflare→origin hop is plaintext while visitors still see a padlock, which
# is the failure mode that looks most like success.
{
	email {$ACME_EMAIL}
	# Trust only Cloudflare's published edge ranges. Trusting private_ranges did
	# not trust Cloudflare at all (its edges use public addresses), so every
	# reader collapsed into one rate-limit bucket. CF-Connecting-IP is replaced
	# by Cloudflare and is only accepted from these peers; a direct origin caller
	# cannot spoof it.
	servers {
		trusted_proxies static \
 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 \
 131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 \
 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 \
 190.93.240.0/20 197.234.240.0/22 198.41.128.0/17 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 \
 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# `/ask` is rate limited per caller in ai-service, and the caller is read
	# from the first X-Forwarded-For entry. Caddy appends to that header, so the
	# original client stays in position one.
	header {
		# The site is served entirely over TLS; tell browsers to keep it that way.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The site embeds nothing and is embedded nowhere.
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# SSE for `/rag/ask/stream` passes through Next's own proxy route. Buffering
	# it here would hold every progress event until the answer arrived and
	# defeat the point of the stream — the reader would watch a blank page for
	# the full 10.5s p50.
	reverse_proxy web:3000 {
		flush_interval -1
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
